{
  "expo": {
    "name": "EXORA",
    "slug": "exora-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "exora",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "newArchEnabled": false,
    "backgroundColor": "#0B0E11",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exora.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.exora.mobile",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E11"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "EXORA needs access to your photo library to attach identity documents for KYC verification.",
          "cameraPermission": "EXORA needs camera access to capture identity documents and a selfie for KYC verification."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B0E11"
        }
      ],
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b073e686-38df-4a2f-a2a1-4b7cde726c92"
      }
    }
  }
}
