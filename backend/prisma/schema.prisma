// ============================================================================
// CEX — FINAL FROZEN PRISMA SCHEMA  ·  v1.0  (REV 2, architecture frozen)
// ----------------------------------------------------------------------------
// CANONICAL source of truth for the database. Frozen 2026-06-12. No redesign.
// Full design rationale: /DATABASE_ARCHITECTURE.md (see §R for REV 2 hardening).
// Baseline migration: prisma/migrations/20260612120000_full_architecture_freeze.
//
// REV 2 closes production-review items C2–C7 and H1–H4:
//   - Chain is now a REFERENCE TABLE (chains), not an enum  ............ H1
//   - hot_wallets / chain_signers / wallet_nonces  .................... wallet infra
//   - crypto_withdrawals.from_address + unique(chain,from_address,nonce) C2
//   - conversions / price_quotes / totp_recovery_codes (restored)  .... C7
//   - sweeps / reconciliation_runs / balance_snapshots  .............. recon
//   - candles / market_tickers / gas_reserves / network_fees  ........ trading + gas
//   - orders.stop_price + market-order quote_budget  ................. C3/C4
//   - ledger_entries(account_id, asset) -> accounts(id, asset) FK  ... C5 (composite)
//   - crypto_deposits.block_hash + (chain, block_number) reorg index . C6
//   - trades.maker_user_id / taker_user_id + deterministic fill_id  .. H3/H4
//   - admin/user FKs for approver/reviewer/granter/updater  .......... H2
//
// Conventions:
//   - UUID PKs via gen_random_uuid(); append-only/high-volume use BigInt.
//   - snake_case via @map; money as Decimal @db.Decimal(p,s) (NUMERIC).
//   - Soft delete: deletedAt on reference rows. Append-only: REVOKE+trigger
//     applied in migration SQL (not expressible in Prisma).
//   - `asset` -> assets.symbol, `chain` -> chains.id (both reference tables) so
//     listing tokens/chains (ERC20/TRC20/BEP20/new L1s/KuCoin) is data, not DDL.
//   - Partial indexes & CHECK constraints that Prisma cannot express are listed
//     in DATABASE_ARCHITECTURE.md §"Partial-index & constraint migration" and
//     authored as raw SQL after `prisma migrate`.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto] // citext for emails/symbols; pgcrypto for gen_random_uuid
}

// ============================================================================
// ENUMS  (only truly-fixed domains stay enums; growable sets are tables)
// ============================================================================
enum UserStatus {
  ACTIVE
  FROZEN
  LOCKED
  CLOSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  MANUAL_REVIEW
  NEEDS_MORE_INFO
  APPROVED
  REJECTED
}

enum KycDocType {
  PAN
  AADHAAR
  PASSPORT
  SELFIE
  ADDRESS_PROOF
}

// Normalized status of an individual provider check (liveness, document, …).
enum KycCheckStatus {
  PENDING
  PASS
  FAIL
  UNAVAILABLE
}

enum ChainFamily {
  EVM // ERC20 / BEP20 — nonce + EVM address semantics
  TRON // TRC20
}

enum WalletTier {
  HOT
  WARM
  COLD
}

enum AccountKind {
  USER_AVAILABLE
  USER_LOCKED
  FEE_REVENUE
  TDS_PAYABLE
  HOT_WALLET
  COLD_WALLET
  GATEWAY_CLEARING
  MANUAL_BANK_CLEARING // funds received in the exchange bank, pending manual credit
  SWEEP_CLEARING
  LIQUIDITY
  SYSTEM
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum DepositStatus {
  DETECTED
  CONFIRMING
  CONFIRMED
  CREDITED
  ORPHANED
}

enum WithdrawalStatus {
  REQUESTED
  RISK_CHECK
  PENDING_APPROVAL
  APPROVED
  QUEUED
  SIGNING
  BROADCAST
  CONFIRMING
  COMPLETED
  REJECTED
  FAILED
  CANCELLED
}

enum SweepStatus {
  PENDING
  SIGNING
  BROADCAST
  CONFIRMING
  COMPLETED
  FAILED
}

enum InrTxnStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum InrTxnType {
  DEPOSIT
  WITHDRAWAL
}

enum ConversionSide {
  INR_TO_USDT
  USDT_TO_INR
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
  STOP_LIMIT
}

enum TimeInForce {
  GTC
  IOC
  FOK
  POST_ONLY
}

enum OrderStatus {
  PENDING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
  EXPIRED
}

enum OrderSource {
  USER
  KUCOIN_HEDGE
  SYSTEM
}

enum MarketStatus {
  ACTIVE
  HALTED
  POST_ONLY
}

enum CandleInterval {
  M1
  M5
  M15
  H1
  H4
  D1
  W1
}

enum FeeKind {
  WITHDRAWAL
  SWEEP
}

enum ReconType {
  CHAIN // ledger vs on-chain hot/cold balances
  GATEWAY // ledger vs payment-gateway settlement
  LEDGER_INVARIANT // projection vs SUM(entries)
}

enum ReconStatus {
  RUNNING
  BALANCED
  DISCREPANCY
  FAILED
}

enum RoleScope {
  USER
  ADMIN
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

enum AssetKind {
  FIAT
  CRYPTO
}

// ============================================================================
// REFERENCE — chains, assets, asset_chains, markets
// ============================================================================
model Chain {
  id            String      @id @db.Citext // 'TRON','ETHEREUM','BSC','POLYGON'...
  name          String
  family        ChainFamily
  nativeAsset   String      @map("native_asset") @db.Citext // gas asset symbol -> assets
  evmChainId    Int?        @map("evm_chain_id") // EVM numeric chain id (null for TRON)
  confirmations Int         @default(12) // default min confirmations
  reorgBuffer   Int         @default(64) @map("reorg_buffer") // rescan depth
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")

  native            Asset               @relation("ChainNativeAsset", fields: [nativeAsset], references: [symbol])
  assetChains       AssetChain[]
  depositAddresses  DepositAddress[]
  withdrawalAddrs   WithdrawalAddress[]
  cryptoDeposits    CryptoDeposit[]
  cryptoWithdrawals CryptoWithdrawal[]
  cursor            ChainCursor?
  hotWallets        HotWallet[]
  signers           ChainSigner[]
  sweeps            Sweep[]
  gasReserves       GasReserve[]
  networkFees       NetworkFee[]

  @@index([isActive])
  @@map("chains")
}

model Asset {
  symbol    String    @id @db.Citext // 'INR','USDT','BTC'...
  name      String
  kind      AssetKind
  decimals  Int // INR=2, USDT=6
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  chains          AssetChain[]
  accounts        Account[]
  baseMarkets     Market[]      @relation("BaseAsset")
  quoteMarkets    Market[]      @relation("QuoteAsset")
  nativeForChains Chain[]       @relation("ChainNativeAsset")
  gasReserves     GasReserve[]
  networkFees     NetworkFee[]
  ledgerEntries   LedgerEntry[]

  @@map("assets")
}

model AssetChain {
  asset            String  @db.Citext
  chain            String  @db.Citext
  contractAddr     String? @map("contract_addr") // token contract per chain (TRC20/ERC20/BEP20)
  decimals         Int // on-chain decimals
  minConfirmations Int     @map("min_confirmations")
  isActive         Boolean @default(true) @map("is_active")

  assetRef Asset @relation(fields: [asset], references: [symbol])
  chainRef Chain @relation(fields: [chain], references: [id])

  @@id([asset, chain])
  @@map("asset_chains")
}

model Market {
  id          String       @id @default(uuid()) @db.Uuid
  symbol      String       @unique // 'BTC-USDT'
  baseAsset   String       @map("base_asset") @db.Citext
  quoteAsset  String       @map("quote_asset") @db.Citext
  status      MarketStatus @default(ACTIVE)
  tickSize    Decimal      @map("tick_size") @db.Decimal(38, 18)
  stepSize    Decimal      @map("step_size") @db.Decimal(38, 18)
  minNotional Decimal      @map("min_notional") @db.Decimal(38, 18)
  makerFeeBps Int          @map("maker_fee_bps")
  takerFeeBps Int          @map("taker_fee_bps")
  createdAt   DateTime     @default(now()) @map("created_at")

  base    Asset         @relation("BaseAsset", fields: [baseAsset], references: [symbol])
  quote   Asset         @relation("QuoteAsset", fields: [quoteAsset], references: [symbol])
  orders  Order[]
  trades  Trade[]
  candles Candle[]
  ticker  MarketTicker?

  @@unique([baseAsset, quoteAsset]) // M2 — no duplicate pairs
  @@index([status])
  @@map("markets")
}

// ============================================================================
// USERS / AUTH / SESSIONS
// ============================================================================
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique @db.Citext
  phone              String?    @unique
  passwordHash       String     @map("password_hash")
  status             UserStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?  @map("email_verified_at")
  phoneVerifiedAt    DateTime?  @map("phone_verified_at")
  kycStatus          KycStatus  @default(NOT_STARTED) @map("kyc_status")
  kycTier            Int        @default(0) @map("kyc_tier")
  withdrawalsBlocked Boolean    @default(false) @map("withdrawals_blocked")
  riskLevel          RiskLevel  @default(LOW) @map("risk_level")
  riskNote           String?    @map("risk_note")
  totpSecretEnc      Bytes?     @map("totp_secret_enc")
  totpEnabled        Boolean    @default(false) @map("totp_enabled")
  referralCode       String?    @unique @map("referral_code")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  sessions          AuthSession[]
  oauthAccounts     OAuthAccount[]
  loginAttempts     LoginAttempt[]
  roles             UserRole[]
  kycProfile        KycProfile?
  kycDocuments      KycDocument[]
  accounts          Account[]
  depositAddrs      DepositAddress[]
  withdrawalAddrs   WithdrawalAddress[]
  cryptoDeposits    CryptoDeposit[]
  cryptoWithdrawals CryptoWithdrawal[]
  inrTransactions   InrTransaction[]
  bankAccounts      BankAccount[]
  orders            Order[]
  conversions       Conversion[]
  priceQuotes       PriceQuote[]
  totpRecoveryCodes TotpRecoveryCode[]
  makerTrades       Trade[]             @relation("TradeMaker")
  takerTrades       Trade[]             @relation("TradeTaker")
  notifications     Notification[]
  complianceProfile ComplianceProfile?
  complianceEvidence ComplianceEvidence[]
  complianceConsents ComplianceConsent[]
  riskAssessments    RiskAssessment[]
  screeningChecks    ScreeningCheck[]
  complianceAlerts   ComplianceAlert[]
  complianceCases    ComplianceCase[]
  walletRiskChecks   WalletRiskCheck[]
  travelRuleTransfers TravelRuleTransfer[]
  complianceEvidencePacks ComplianceEvidencePack[]
  userTaxProfile     UserTaxProfile?
  tdsRecords         TdsRecord[]
  taxStatements      TaxStatement[]
  legalAcceptances   UserLegalAcceptance[]
  fiuDraftReports    FiuDraftReport[]

  @@index([status])
  @@index([kycStatus])
  @@map("users")
}

/// Links an external identity provider (e.g. Google) to a local User.
/// Additive only: the users table is unchanged. OAuth-only users get an
/// unusable random password hash so password login never succeeds for them.
model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String // "google"
  providerAccountId String   @map("provider_account_id") // Google "sub"
  email             String? // email captured at link time (audit only)
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model AuthSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  refreshHash String    @map("refresh_hash")
  familyId    String    @map("family_id") @db.Uuid
  deviceInfo  Json?     @map("device_info")
  ip          String?   @db.Inet
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // partial WHERE revoked_at IS NULL applied in migration SQL
  @@index([familyId])
  @@index([refreshHash]) // refresh-token lookup
  @@map("auth_sessions")
}

model TotpRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // partial WHERE used_at IS NULL in migration SQL (unused codes)
  @@map("totp_recovery_codes")
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  email     String?  @db.Citext
  ip        String?  @db.Inet
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ip, createdAt]) // IP-based rate limiting
  @@map("login_attempts") // RANGE-partition monthly on created_at (raw SQL)
}

// ============================================================================
// RBAC — roles, permissions (users + admins)
// ============================================================================
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  scope       RoleScope
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")

  permissions RolePermission[]
  userRoles   UserRole[]
  adminRoles  AdminRole[]

  @@index([scope])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique // 'withdrawal.approve'
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedByAdmin Admin? @relation("RoleGranter", fields: [grantedBy], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AdminRole {
  adminId String @map("admin_id") @db.Uuid
  roleId  String @map("role_id") @db.Uuid

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@index([roleId])
  @@map("admin_roles")
}

// ============================================================================
// KYC
// ============================================================================
model KycProfile {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @unique @map("user_id") @db.Uuid
  fullName            String?         @map("full_name")
  dob                 DateTime?       @db.Date
  panEnc              Bytes?          @map("pan_enc")
  aadhaarRefEnc       Bytes?          @map("aadhaar_ref_enc")
  address             Json?
  status              KycStatus       @default(PENDING)
  provider            String?
  providerRef         String?         @map("provider_ref")
  // Generic third-party provider linkage + normalized outcome (vendor-neutral).
  providerSessionId   String?         @map("provider_session_id")
  providerApplicantId String?         @map("provider_applicant_id")
  panMasked           String?         @map("pan_masked")
  aadhaarMasked       String?         @map("aadhaar_masked")
  livenessStatus      KycCheckStatus? @map("liveness_status")
  documentStatus      KycCheckStatus? @map("document_status")
  riskScore           Int?            @map("risk_score")
  rejectedReason      String?         @map("rejected_reason")
  // Internal compliance note — admin-only, NEVER exposed on user-facing APIs.
  complianceNote      String?         @map("compliance_note")
  reviewedBy          String?         @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?       @map("reviewed_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  user     User   @relation(fields: [userId], references: [id])
  reviewer Admin? @relation("KycReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([providerSessionId])
  @@index([providerApplicantId])
  @@map("kyc_profiles")
}

// Append-only inbound KYC provider webhook events. Mirrors
// PaymentWebhookEvent: the (provider, providerEventId) unique key is the
// idempotency guard so redelivered events are processed at most once.
model KycWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  signatureOk     Boolean   @map("signature_ok")
  payload         Json
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([processedAt])
  @@map("kyc_webhook_events")
}

model KycDocument {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  docType    KycDocType @map("doc_type")
  storageKey String     @map("storage_key")
  sha256     String
  status     KycStatus  @default(PENDING)
  createdAt  DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("kyc_documents")
}

// ============================================================================
// NOTIFICATIONS (in-app user notifications + email delivery tracking)
// ============================================================================
enum NotificationType {
  KYC_APPROVED
  KYC_REJECTED
  KYC_NEEDS_MORE_INFO
  KYC_SUBMITTED
  KYC_LIVENESS_FAILED
  COMPLIANCE_REVIEW_COMPLETED
  INR_DEPOSIT_SUBMITTED
  INR_DEPOSIT_APPROVED
  INR_DEPOSIT_REJECTED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_COMPLETED
  PASSWORD_CHANGED
  SECURITY_SESSION_REVOKED
}

// Outcome of the optional email side-channel for a notification. Never carries
// secrets — only a coarse status used for admin delivery visibility.
enum NotificationEmailStatus {
  SENT // dispatched via the live (SES) provider
  LOGGED // recorded by the offline 'log' provider (no real email sent)
  SKIPPED // no email channel for this type / no recipient
  FAILED // provider raised an error (notification row still created)
}

model Notification {
  id          String                   @id @default(uuid()) @db.Uuid
  userId      String                   @map("user_id") @db.Uuid
  type        NotificationType
  title       String
  message     String
  metadata    Json?
  emailStatus NotificationEmailStatus? @map("email_status")
  readAt      DateTime?                @map("read_at")
  createdAt   DateTime                 @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// LEDGER (double-entry, append-only) — WALLETS + TRANSACTIONS
// ============================================================================
model Account {
  id        String      @id @default(uuid()) @db.Uuid
  kind      AccountKind
  userId    String?     @map("user_id") @db.Uuid // null for system accounts
  asset     String      @db.Citext
  createdAt DateTime    @default(now()) @map("created_at")

  user     User?           @relation(fields: [userId], references: [id])
  assetRef Asset           @relation(fields: [asset], references: [symbol])
  balance  AccountBalance?
  entries  LedgerEntry[]

  @@unique([userId, asset, kind])
  @@unique([id, asset]) // composite-FK target for ledger_entries (C5)
  @@index([kind, asset])
  @@map("accounts")
}

model AccountBalance {
  accountId String   @id @map("account_id") @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(38, 18)
  version   BigInt   @default(0) // optimistic concurrency
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])

  @@map("account_balances")
}

model LedgerTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  kind          String // DEPOSIT_CREDIT, TRADE_SETTLE, CONVERSION, SWEEP, ...
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  entries          LedgerEntry[]
  creditedDeposits CryptoDeposit[]    @relation("DepositCredit")
  holdWithdrawals  CryptoWithdrawal[] @relation("WithdrawalHold")
  finalWithdrawals CryptoWithdrawal[] @relation("WithdrawalFinal")
  inrSettlements   InrTransaction[]
  conversions      Conversion[]
  orderLocks       Order[]
  tradeSettlements Trade[]
  sweeps           Sweep[]

  @@index([referenceType, referenceId])
  @@index([kind, createdAt])
  @@map("ledger_transactions")
}

// APPEND-ONLY. sum(signed amount)=0 per (txn, asset) — enforced by deferred trigger.
// PK is composite (id, created_at) to allow RANGE partitioning on created_at.
// C5: account relation is COMPOSITE (account_id, asset) -> accounts(id, asset),
//     so an entry's asset can never disagree with its account's asset.
model LedgerEntry {
  id        BigInt         @default(autoincrement())
  txnId     String         @map("txn_id") @db.Uuid
  accountId String         @map("account_id") @db.Uuid
  direction EntryDirection
  amount    Decimal        @db.Decimal(38, 18) // magnitude > 0; sign from direction
  asset     String         @db.Citext
  createdAt DateTime       @default(now()) @map("created_at")

  txn      LedgerTransaction @relation(fields: [txnId], references: [id])
  account  Account           @relation(fields: [accountId, asset], references: [id, asset])
  assetRef Asset             @relation(fields: [asset], references: [symbol])

  @@id([id, createdAt])
  @@index([accountId, createdAt])
  @@index([txnId])
  @@map("ledger_entries")
}

// ============================================================================
// WALLET ADDRESSES (user-facing)
// ============================================================================
model DepositAddress {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  chain           String   @db.Citext
  address         String
  derivationIndex BigInt   @map("derivation_index")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id])
  chainRef Chain           @relation(fields: [chain], references: [id])
  deposits CryptoDeposit[]
  sweeps   Sweep[]

  @@unique([chain, address])
  @@unique([chain, derivationIndex]) // no HD index reuse per chain
  @@index([userId, chain]) // partial UNIQUE WHERE is_active in migration SQL (H6 rotation)
  @@index([address])
  @@map("deposit_addresses")
}

model WithdrawalAddress {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  chain         String    @db.Citext
  address       String
  label         String?
  whitelistedAt DateTime? @map("whitelisted_at") // null until cooling-off passes
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  user     User  @relation(fields: [userId], references: [id])
  chainRef Chain @relation(fields: [chain], references: [id])

  @@unique([userId, chain, address]) // partial WHERE deleted_at IS NULL in migration SQL
  @@map("withdrawal_addresses")
}

// ============================================================================
// WALLET INFRASTRUCTURE — signers, hot wallets, nonce sequencer
// ============================================================================
model ChainSigner {
  id        String   @id @default(uuid()) @db.Uuid
  chain     String   @db.Citext
  name      String
  kmsKeyRef String   @map("kms_key_ref") // KMS/HSM key reference — NEVER the key material
  publicKey String?  @map("public_key")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")

  chainRef   Chain       @relation(fields: [chain], references: [id])
  hotWallets HotWallet[]

  @@unique([chain, kmsKeyRef])
  @@index([chain, status])
  @@map("chain_signers")
}

model HotWallet {
  id        String     @id @default(uuid()) @db.Uuid
  chain     String     @db.Citext
  signerId  String     @map("signer_id") @db.Uuid
  address   String
  tier      WalletTier @default(HOT)
  label     String?
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")

  chainRef    Chain              @relation(fields: [chain], references: [id])
  signer      ChainSigner        @relation(fields: [signerId], references: [id])
  nonce       WalletNonce?
  withdrawals CryptoWithdrawal[]
  sweeps      Sweep[]
  gasReserves GasReserve[]

  @@unique([chain, address])
  @@index([chain, tier, isActive])
  @@map("hot_wallets")
}

// Authoritative nonce allocator — one row per hot wallet, row-locked on allocation.
// Scopes the (chain, from_address, nonce) uniqueness on crypto_withdrawals (C2).
model WalletNonce {
  hotWalletId String   @id @map("hot_wallet_id") @db.Uuid
  nextNonce   BigInt   @default(0) @map("next_nonce")
  updatedAt   DateTime @updatedAt @map("updated_at")

  hotWallet HotWallet @relation(fields: [hotWalletId], references: [id], onDelete: Cascade)

  @@map("wallet_nonces")
}

// ============================================================================
// CRYPTO DEPOSITS  (+ reorg handling: block_hash)  C6
// ============================================================================
model CryptoDeposit {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String?       @map("user_id") @db.Uuid
  addressId        String?       @map("address_id") @db.Uuid
  chain            String        @db.Citext
  asset            String        @db.Citext
  txHash           String        @map("tx_hash")
  logIndex         Int           @default(0) @map("log_index")
  fromAddress      String?       @map("from_address")
  amountBase       Decimal       @map("amount_base") @db.Decimal(78, 0) // chain truth
  amount           Decimal       @db.Decimal(38, 18) // human
  confirmations    Int           @default(0)
  reqConfirmations Int           @map("req_confirmations") // snapshot of threshold at detection
  status           DepositStatus @default(DETECTED)
  blockNumber      BigInt?       @map("block_number")
  blockHash        String?       @map("block_hash") // C6 — reorg detection at same height
  creditedTxnId    String?       @map("credited_txn_id") @db.Uuid
  detectedAt       DateTime      @default(now()) @map("detected_at")
  creditedAt       DateTime?     @map("credited_at")

  user        User?              @relation(fields: [userId], references: [id])
  address     DepositAddress?    @relation(fields: [addressId], references: [id])
  chainRef    Chain              @relation(fields: [chain], references: [id])
  creditedTxn LedgerTransaction? @relation("DepositCredit", fields: [creditedTxnId], references: [id])

  @@unique([chain, txHash, logIndex]) // idempotent credit
  @@index([status]) // partial WHERE status IN ('DETECTED','CONFIRMING') in migration SQL
  @@index([userId])
  @@index([chain, blockNumber]) // C6 — reorg rescan window
  @@map("crypto_deposits")
}

model ChainCursor {
  chain            String   @id @db.Citext
  lastScannedBlock BigInt   @map("last_scanned_block")
  lastScannedHash  String?  @map("last_scanned_hash") // C6 — canonical tip hash
  safeBlock        BigInt   @default(0) @map("safe_block") // confirmed-final height
  updatedAt        DateTime @updatedAt @map("updated_at")

  chainRef Chain @relation(fields: [chain], references: [id])

  @@map("chain_cursors")
}

// ============================================================================
// SWEEPS — deposit-address -> hot-wallet consolidation (SWEEP_CLEARING)
// ============================================================================
model Sweep {
  id            String      @id @default(uuid()) @db.Uuid
  chain         String      @db.Citext
  asset         String      @db.Citext
  fromAddressId String?     @map("from_address_id") @db.Uuid
  fromAddress   String      @map("from_address")
  toHotWalletId String      @map("to_hot_wallet_id") @db.Uuid
  amount        Decimal     @db.Decimal(38, 18)
  amountBase    Decimal     @map("amount_base") @db.Decimal(78, 0)
  status        SweepStatus @default(PENDING)
  txHash        String?     @map("tx_hash")
  nonce         BigInt?
  blockNumber   BigInt?     @map("block_number")
  blockHash     String?     @map("block_hash")
  ledgerTxnId   String?     @map("ledger_txn_id") @db.Uuid
  failureReason String?     @map("failure_reason")
  createdAt     DateTime    @default(now()) @map("created_at")
  completedAt   DateTime?   @map("completed_at")

  chainRef    Chain              @relation(fields: [chain], references: [id])
  fromDeposit DepositAddress?    @relation(fields: [fromAddressId], references: [id])
  toHotWallet HotWallet          @relation(fields: [toHotWalletId], references: [id])
  ledgerTxn   LedgerTransaction? @relation(fields: [ledgerTxnId], references: [id])
  networkFees NetworkFee[]

  @@unique([chain, txHash]) // partial WHERE tx_hash IS NOT NULL in migration SQL
  @@index([status])
  @@index([toHotWalletId])
  @@map("sweeps")
}

// ============================================================================
// CRYPTO WITHDRAWALS  (+ from_address, nonce scoping, approver FKs)  C2/H2
// ============================================================================
model CryptoWithdrawal {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  chain         String           @db.Citext
  asset         String           @db.Citext
  toAddress     String           @map("to_address")
  fromAddress   String?          @map("from_address") // sending hot-wallet address (C2)
  hotWalletId   String?          @map("hot_wallet_id") @db.Uuid
  amount        Decimal          @db.Decimal(38, 18) // gross requested
  fee           Decimal          @default(0) @db.Decimal(38, 18)
  tdsAmount     Decimal          @default(0) @map("tds_amount") @db.Decimal(38, 18)
  netAmount     Decimal          @map("net_amount") @db.Decimal(38, 18)
  status        WithdrawalStatus @default(REQUESTED)
  holdTxnId     String?          @map("hold_txn_id") @db.Uuid
  finalTxnId    String?          @map("final_txn_id") @db.Uuid
  txHash        String?          @map("tx_hash")
  nonce         BigInt?
  approvedBy    String?          @map("approved_by") @db.Uuid
  approvedBy2   String?          @map("approved_by_2") @db.Uuid
  approverSig   String?          @map("approver_sig")
  riskFlags     Json?            @map("risk_flags")
  failureReason String?          @map("failure_reason")
  requestedAt   DateTime         @default(now()) @map("requested_at")
  broadcastAt   DateTime?        @map("broadcast_at")
  completedAt   DateTime?        @map("completed_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id])
  chainRef    Chain              @relation(fields: [chain], references: [id])
  hotWallet   HotWallet?         @relation(fields: [hotWalletId], references: [id])
  holdTxn     LedgerTransaction? @relation("WithdrawalHold", fields: [holdTxnId], references: [id])
  finalTxn    LedgerTransaction? @relation("WithdrawalFinal", fields: [finalTxnId], references: [id])
  approver    Admin?             @relation("WithdrawApprover1", fields: [approvedBy], references: [id])
  approver2   Admin?             @relation("WithdrawApprover2", fields: [approvedBy2], references: [id])
  networkFees NetworkFee[]

  @@unique([chain, fromAddress, nonce]) // C2/H2 — partial WHERE nonce IS NOT NULL (migration SQL)
  @@index([status]) // partial WHERE status NOT IN terminal states (migration SQL)
  @@index([userId])
  @@index([txHash])
  @@map("crypto_withdrawals")
}

// ============================================================================
// GAS / NETWORK FEES  (native-asset accounting)
// ============================================================================
model GasReserve {
  id               String   @id @default(uuid()) @db.Uuid
  chain            String   @db.Citext
  hotWalletId      String?  @map("hot_wallet_id") @db.Uuid
  asset            String   @db.Citext // native gas asset (TRX/ETH/BNB)
  balanceBase      Decimal  @map("balance_base") @db.Decimal(78, 0)
  lowWatermarkBase Decimal? @map("low_watermark_base") @db.Decimal(78, 0)
  updatedAt        DateTime @updatedAt @map("updated_at")

  chainRef  Chain      @relation(fields: [chain], references: [id])
  hotWallet HotWallet? @relation(fields: [hotWalletId], references: [id])
  assetRef  Asset      @relation(fields: [asset], references: [symbol])

  @@unique([chain, hotWalletId, asset])
  @@map("gas_reserves")
}

// Actual gas spent per outbound tx — reconciles estimated vs paid.
model NetworkFee {
  id           String   @id @default(uuid()) @db.Uuid
  chain        String   @db.Citext
  asset        String   @db.Citext // native asset paid as gas
  feeKind      FeeKind  @map("fee_kind")
  withdrawalId String?  @map("withdrawal_id") @db.Uuid
  sweepId      String?  @map("sweep_id") @db.Uuid
  txHash       String?  @map("tx_hash")
  gasUsed      BigInt?  @map("gas_used")
  gasPriceBase Decimal? @map("gas_price_base") @db.Decimal(78, 0)
  feeBase      Decimal  @map("fee_base") @db.Decimal(78, 0)
  feeAsset     Decimal  @map("fee_asset") @db.Decimal(38, 18)
  createdAt    DateTime @default(now()) @map("created_at")

  chainRef   Chain             @relation(fields: [chain], references: [id])
  assetRef   Asset             @relation(fields: [asset], references: [symbol])
  withdrawal CryptoWithdrawal? @relation(fields: [withdrawalId], references: [id])
  sweep      Sweep?            @relation(fields: [sweepId], references: [id])

  @@index([chain, createdAt])
  @@index([withdrawalId])
  @@index([sweepId])
  @@map("network_fees")
}

// ============================================================================
// INR (FIAT) LEDGER + CONVERSION
// ============================================================================
model InrTransaction {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  type              InrTxnType
  amount            Decimal      @db.Decimal(20, 2)
  fee               Decimal      @default(0) @db.Decimal(20, 2)
  status            InrTxnStatus @default(INITIATED)
  provider          String?
  providerOrderId   String?      @map("provider_order_id")
  providerPaymentId String?      @map("provider_payment_id")
  bankRef           String?      @map("bank_ref")
  ledgerTxnId       String?      @map("ledger_txn_id") @db.Uuid
  // Manual INR deposit fields (provider = 'MANUAL'): user-submitted bank/UPI
  // reference and admin review trail. Crediting still flows exclusively through
  // the double-entry ledger on admin approval.
  utr               String?      @map("utr") // bank/UPI reference, manual deposits
  method            String?      @map("method") // 'UPI' | 'IMPS' | 'NEFT' | 'QR' | 'BANK'
  proofKey          String?      @map("proof_key") // object-storage key for the proof screenshot (optional)
  // Maker-checker (Stage 3.4C): first approver for dual-approval deposits. The
  // final/second approver (or rejecter) is reviewedBy. Below the threshold,
  // firstApprovedBy stays null and reviewedBy alone records the single approver.
  firstApprovedBy   String?      @map("first_approved_by") @db.Uuid
  firstApprovedAt   DateTime?    @map("first_approved_at")
  reviewedBy        String?      @map("reviewed_by") @db.Uuid // admin who finally approved/rejected
  reviewedAt        DateTime?    @map("reviewed_at")
  rejectionReason   String?      @map("rejection_reason")
  metadata          Json?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id])
  ledgerTxn     LedgerTransaction? @relation(fields: [ledgerTxnId], references: [id])
  reviewer      Admin?             @relation("InrDepositReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  firstApprover Admin?             @relation("InrDepositFirstApprover", fields: [firstApprovedBy], references: [id], onDelete: SetNull)

  @@unique([provider, providerPaymentId]) // idempotent settlement
  @@unique([provider, utr]) // duplicate-UTR guard; NULL utr (Razorpay) rows never collide (NULLs distinct)
  @@index([userId, type])
  @@index([status])
  @@index([status, createdAt]) // pending-queue dashboard
  @@index([provider, providerOrderId]) // webhook -> txn reconcile
  @@map("inr_transactions")
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  signatureOk     Boolean   @map("signature_ok")
  payload         Json
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([processedAt]) // partial WHERE processed_at IS NULL (unprocessed queue) in migration SQL
  @@map("payment_webhook_events")
}

model BankAccount {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  accountNumberEnc Bytes     @map("account_number_enc")
  ifsc             String
  holderName       String    @map("holder_name")
  verifiedAt       DateTime? @map("verified_at") // penny-drop
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("bank_accounts")
}

// Short-lived signed price quote (INR<->USDT)
model PriceQuote {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  side      ConversionSide
  rate      Decimal        @db.Decimal(20, 8) // INR per USDT incl. spread
  spreadBps Int            @map("spread_bps")
  expiresAt DateTime       @map("expires_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id])
  conversions Conversion[]

  @@index([userId])
  @@index([expiresAt])
  @@map("price_quotes")
}

model Conversion {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  quoteId     String?        @map("quote_id") @db.Uuid
  side        ConversionSide
  inrAmount   Decimal        @map("inr_amount") @db.Decimal(20, 2)
  usdtAmount  Decimal        @map("usdt_amount") @db.Decimal(38, 6)
  rate        Decimal        @db.Decimal(20, 8)
  feeInr      Decimal        @default(0) @map("fee_inr") @db.Decimal(20, 2)
  tdsAmount   Decimal        @default(0) @map("tds_amount") @db.Decimal(20, 2) // §194S 1%
  ledgerTxnId String?        @map("ledger_txn_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")

  user      User               @relation(fields: [userId], references: [id])
  quote     PriceQuote?        @relation(fields: [quoteId], references: [id])
  ledgerTxn LedgerTransaction? @relation(fields: [ledgerTxnId], references: [id])

  @@index([userId, createdAt])
  @@map("conversions")
}

// ============================================================================
// ORDERS & TRADES (spot)  — stop_price, quote_budget, denormalized users  C3/C4/H3/H4
// ============================================================================
model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  marketId       String      @map("market_id") @db.Uuid
  clientOrderId  String?     @map("client_order_id")
  side           OrderSide
  type           OrderType
  tif            TimeInForce @default(GTC)
  price          Decimal?    @db.Decimal(38, 18) // null for MARKET
  stopPrice      Decimal?    @map("stop_price") @db.Decimal(38, 18) // C4 — STOP_LIMIT trigger
  quantity       Decimal?    @db.Decimal(38, 18) // null for MARKET-BUY (budget-driven)
  quoteBudget    Decimal?    @map("quote_budget") @db.Decimal(38, 18) // C3 — MARKET-BUY lock budget
  filledQuantity Decimal     @default(0) @map("filled_quantity") @db.Decimal(38, 18)
  quoteSpent     Decimal     @default(0) @map("quote_spent") @db.Decimal(38, 18)
  lockedAmount   Decimal?    @map("locked_amount") @db.Decimal(38, 18) // exact reserved amount
  lockedAsset    String?     @map("locked_asset") @db.Citext // asset reserved (surplus release)
  status         OrderStatus @default(PENDING)
  lockTxnId      String?     @map("lock_txn_id") @db.Uuid
  source         OrderSource @default(USER)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  closedAt       DateTime?   @map("closed_at")

  user        User               @relation(fields: [userId], references: [id])
  market      Market             @relation(fields: [marketId], references: [id])
  lockTxn     LedgerTransaction? @relation(fields: [lockTxnId], references: [id])
  makerTrades Trade[]            @relation("MakerOrder")
  takerTrades Trade[]            @relation("TakerOrder")

  @@unique([userId, clientOrderId]) // partial WHERE client_order_id IS NOT NULL
  @@index([marketId, status]) // partial WHERE status IN (OPEN,PARTIALLY_FILLED) — book rebuild
  @@index([marketId, type, status]) // partial WHERE type='STOP_LIMIT' — stop monitor
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

// APPEND-ONLY immutable execution record. PK (id, executedAt) for partitioning.
// H3: fill_id is the engine's DETERMINISTIC fill identifier (idempotent settle).
// H4: maker_user_id / taker_user_id denormalized for user trade history.
model Trade {
  id           String    @default(uuid()) @db.Uuid
  fillId       String    @map("fill_id") // deterministic engine fill id
  marketId     String    @map("market_id") @db.Uuid
  makerOrderId String    @map("maker_order_id") @db.Uuid
  takerOrderId String    @map("taker_order_id") @db.Uuid
  makerUserId  String    @map("maker_user_id") @db.Uuid
  takerUserId  String    @map("taker_user_id") @db.Uuid
  price        Decimal   @db.Decimal(38, 18)
  quantity     Decimal   @db.Decimal(38, 18)
  quoteAmount  Decimal   @map("quote_amount") @db.Decimal(38, 18)
  makerFee     Decimal   @default(0) @map("maker_fee") @db.Decimal(38, 18)
  takerFee     Decimal   @default(0) @map("taker_fee") @db.Decimal(38, 18)
  makerSide    OrderSide @map("maker_side")
  settleTxnId  String?   @map("settle_txn_id") @db.Uuid
  seq          BigInt    @default(autoincrement()) // global tape ordering
  executedAt   DateTime  @default(now()) @map("executed_at")

  market     Market             @relation(fields: [marketId], references: [id])
  makerOrder Order              @relation("MakerOrder", fields: [makerOrderId], references: [id])
  takerOrder Order              @relation("TakerOrder", fields: [takerOrderId], references: [id])
  makerUser  User               @relation("TradeMaker", fields: [makerUserId], references: [id])
  takerUser  User               @relation("TradeTaker", fields: [takerUserId], references: [id])
  settleTxn  LedgerTransaction? @relation(fields: [settleTxnId], references: [id])

  @@id([id, executedAt])
  @@unique([fillId]) // H3 — deterministic idempotent settlement
  @@index([marketId, executedAt])
  @@index([makerUserId, executedAt]) // H4 — user trade history
  @@index([takerUserId, executedAt]) // H4 — user trade history
  @@index([makerOrderId])
  @@index([takerOrderId])
  @@map("trades")
}

// ============================================================================
// MARKET DATA — candles (OHLCV) + 24h ticker
// ============================================================================
model Candle {
  marketId    String         @map("market_id") @db.Uuid
  interval    CandleInterval
  openTime    DateTime       @map("open_time")
  open        Decimal        @db.Decimal(38, 18)
  high        Decimal        @db.Decimal(38, 18)
  low         Decimal        @db.Decimal(38, 18)
  close       Decimal        @db.Decimal(38, 18)
  baseVolume  Decimal        @default(0) @map("base_volume") @db.Decimal(38, 18)
  quoteVolume Decimal        @default(0) @map("quote_volume") @db.Decimal(38, 18)
  tradeCount  Int            @default(0) @map("trade_count")

  market Market @relation(fields: [marketId], references: [id])

  @@id([marketId, interval, openTime])
  @@index([marketId, interval, openTime(sort: Desc)])
  @@map("candles") // candidate for partition by open_time when large
}

model MarketTicker {
  marketId       String   @id @map("market_id") @db.Uuid
  lastPrice      Decimal? @map("last_price") @db.Decimal(38, 18)
  bestBid        Decimal? @map("best_bid") @db.Decimal(38, 18)
  bestAsk        Decimal? @map("best_ask") @db.Decimal(38, 18)
  high24h        Decimal? @map("high_24h") @db.Decimal(38, 18)
  low24h         Decimal? @map("low_24h") @db.Decimal(38, 18)
  open24h        Decimal? @map("open_24h") @db.Decimal(38, 18)
  baseVolume24h  Decimal  @default(0) @map("base_volume_24h") @db.Decimal(38, 18)
  quoteVolume24h Decimal  @default(0) @map("quote_volume_24h") @db.Decimal(38, 18)
  priceChangePct Decimal? @map("price_change_pct") @db.Decimal(10, 4)
  updatedAt      DateTime @updatedAt @map("updated_at")

  market Market @relation(fields: [marketId], references: [id])

  @@map("market_tickers")
}

// ============================================================================
// RECONCILIATION — runs + balance snapshots
// ============================================================================
model ReconciliationRun {
  id         String      @id @default(uuid()) @db.Uuid
  type       ReconType
  scope      String? // chain id / provider / asset under reconciliation
  status     ReconStatus @default(RUNNING)
  expected   Decimal?    @db.Decimal(38, 18)
  actual     Decimal?    @db.Decimal(38, 18)
  diff       Decimal?    @db.Decimal(38, 18)
  details    Json?
  startedAt  DateTime    @default(now()) @map("started_at")
  finishedAt DateTime?   @map("finished_at")

  snapshots BalanceSnapshot[]

  @@index([type, startedAt])
  @@index([status])
  @@map("reconciliation_runs")
}

// Point-in-time balance per account (audit/recon). Append-only, partitionable.
model BalanceSnapshot {
  id         BigInt   @default(autoincrement())
  accountId  String   @map("account_id") @db.Uuid
  reconRunId String?  @map("recon_run_id") @db.Uuid
  balance    Decimal  @db.Decimal(38, 18)
  entryHwm   BigInt?  @map("entry_hwm") // ledger_entries id high-water-mark at snapshot
  takenAt    DateTime @default(now()) @map("taken_at")

  reconRun ReconciliationRun? @relation(fields: [reconRunId], references: [id])

  @@id([id, takenAt])
  @@index([accountId, takenAt])
  @@map("balance_snapshots") // RANGE-partition monthly on taken_at (raw SQL)
}

// ============================================================================
// ADMIN / ADMIN LOGS
// ============================================================================
model Admin {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.Citext
  passwordHash  String   @map("password_hash")
  totpSecretEnc Bytes    @map("totp_secret_enc")
  totpEnabled   Boolean  @default(true) @map("totp_enabled")
  status        String   @default("ACTIVE")
  // Per-admin IPv4 allowlist (exact IPs or CIDRs). Empty = no IP restriction.
  // Enforced at login and on every admin API request.
  ipAllowlist   String[] @default([]) @map("ip_allowlist")
  createdAt     DateTime @default(now()) @map("created_at")

  roles                 AdminRole[]
  sessions              AdminSession[]
  logs                  AdminLog[]
  reviewedKycProfiles   KycProfile[]       @relation("KycReviewer")
  approvedWithdrawals   CryptoWithdrawal[] @relation("WithdrawApprover1")
  approvedWithdrawals2  CryptoWithdrawal[] @relation("WithdrawApprover2")
  grantedRoles          UserRole[]         @relation("RoleGranter")
  updatedFlags          SystemFlag[]       @relation("FlagUpdater")
  reviewedInrDeposits   InrTransaction[]   @relation("InrDepositReviewer")
  firstApprovedDeposits InrTransaction[]   @relation("InrDepositFirstApprover")
  reviewedComplianceProfiles ComplianceProfile[]  @relation("ComplianceReviewer")
  reviewedComplianceEvidence ComplianceEvidence[] @relation("ComplianceEvidenceReviewer")
  authoredRiskAssessments    RiskAssessment[]     @relation("RiskAssessmentAuthor")
  decidedScreeningChecks     ScreeningCheck[]     @relation("ScreeningDecider")

  @@map("admins")
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminId     String    @map("admin_id") @db.Uuid
  refreshHash String    @map("refresh_hash")
  ip          String?   @db.Inet
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

// APPEND-ONLY. RANGE-partition monthly on occurred_at. PK (id, occurredAt).
model AdminLog {
  id          BigInt   @default(autoincrement())
  adminId     String   @map("admin_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  reason      String?
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ip          String?  @db.Inet
  requestId   String?  @map("request_id")
  occurredAt  DateTime @default(now()) @map("occurred_at")

  admin Admin @relation(fields: [adminId], references: [id])

  @@id([id, occurredAt])
  @@index([adminId, occurredAt])
  @@index([targetType, targetId])
  @@index([action, occurredAt])
  @@map("admin_logs")
}

// ============================================================================
// AUDIT (append-only, hash-chained, partitioned)
// ============================================================================
model AuditLog {
  id          BigInt    @default(autoincrement())
  occurredAt  DateTime  @default(now()) @map("occurred_at")
  actorType   ActorType @map("actor_type")
  actorId     String?   @map("actor_id") @db.Uuid
  action      String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  beforeState Json?     @map("before_state")
  afterState  Json?     @map("after_state")
  ip          String?   @db.Inet
  userAgent   String?   @map("user_agent")
  requestId   String?   @map("request_id")
  prevHash    String?   @map("prev_hash") // hash chaining (tamper evidence)
  rowHash     String?   @map("row_hash")
  metadata    Json?

  @@id([id, occurredAt])
  @@index([actorType, actorId])
  @@index([entityType, entityId])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

// ============================================================================
// SYSTEM CONFIG / LIMITS / IDEMPOTENCY
// ============================================================================
model TierLimit {
  kycTier             Int      @id @map("kyc_tier")
  inrDailyDeposit     Decimal? @map("inr_daily_deposit") @db.Decimal(20, 2)
  inrDailyWithdrawal  Decimal? @map("inr_daily_withdrawal") @db.Decimal(20, 2)
  usdtDailyWithdrawal Decimal? @map("usdt_daily_withdrawal") @db.Decimal(38, 6)

  @@map("tier_limits")
}

model SystemFlag {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  updater Admin? @relation("FlagUpdater", fields: [updatedBy], references: [id])

  @@map("system_flags")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  endpoint       String
  key            String
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, endpoint, key])
  @@index([createdAt]) // TTL sweeper
  @@map("idempotency_keys")
}

// ============================================================================
// COMPLIANCE / FIU-PMLA READINESS  (Stage 5.0)
// ----------------------------------------------------------------------------
// Additive only. These tables layer an FIU/PMLA-ready compliance record on top
// of the existing KYC module without altering it. Sensitive identifiers are
// stored MASKED (last-4 / masked) and, where the existing AES-256-GCM KYC
// encryption layer is reused, sealed in *Enc Bytes columns — NEVER as plaintext.
// This is a technical compliance layer; it does not by itself constitute legal
// compliance (requires legal/compliance sign-off).
// ============================================================================

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

/// Compliance risk grade. Distinct from the lighter user-facing RiskLevel so it
/// can carry the terminal PROHIBITED grade used to hard-block onboarding.
enum ComplianceRiskLevel {
  LOW
  MEDIUM
  HIGH
  PROHIBITED
}

/// Enhanced KYC lifecycle for the compliance profile (Scope B). Kept separate
/// from the legacy KycStatus enum so the existing KYC state machine is untouched.
enum ComplianceKycStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  NEEDS_MORE_INFO
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum GeoCaptureStatus {
  NOT_CAPTURED
  CAPTURED
  PARTIAL
  UNAVAILABLE
}

enum LivenessStatus {
  NOT_STARTED
  PENDING
  PASSED
  FAILED
  REVIEW_REQUIRED
}

/// Normalized outcome of an AML/CFT screening dimension (sanctions / PEP /
/// adverse-media). In staging these are driven by the mock and clearly marked.
enum ScreeningStatus {
  NOT_SCREENED
  PENDING
  CLEAR
  HIT
  REVIEW_REQUIRED
}

enum ComplianceEvidenceType {
  PAN
  AADHAAR
  SELFIE
  LIVENESS
  ADDRESS
  GEOLOCATION
  DEVICE
  CONSENT
  PROVIDER_RESPONSE
}

enum ComplianceEvidenceStatus {
  PENDING
  VERIFIED
  REJECTED
  INFO
}

enum ConsentType {
  KYC_PROCESSING
  AML_SCREENING
  DATA_RETENTION
  TERMS_ACCEPTANCE
  RISK_DISCLOSURE
}

enum RiskAssessmentSource {
  KYC
  TRANSACTION
  ADMIN
  SCREENING
  SYSTEM
}

/// Outcome of a single sanctions/PEP/adverse-media screening check (Stage 5.1).
/// Distinct from the lighter ScreeningStatus used as the per-dimension posture on
/// ComplianceProfile — this carries the richer provider lifecycle.
enum ScreeningCheckStatus {
  PENDING
  CLEAR
  POSSIBLE_MATCH
  FAILED
  ERROR
}

/// Screening dimension a check covers.
enum ScreeningCategory {
  SANCTIONS
  PEP
  ADVERSE_MEDIA
}

/// Admin disposition of a screening check (Stage 5.1).
enum ScreeningDecision {
  APPROVED
  REJECTED
  NEEDS_REVIEW
  FALSE_POSITIVE
}

/// One compliance profile per user: identity, address, masked IDs, onboarding
/// geo/IP evidence, risk grade, screening posture, and review scheduling.
model ComplianceProfile {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @unique @map("user_id") @db.Uuid
  customerType        CustomerType        @default(INDIVIDUAL) @map("customer_type")
  status              ComplianceKycStatus @default(NOT_STARTED)

  // Identity
  fullName            String?             @map("full_name")
  dateOfBirth         DateTime?           @map("date_of_birth") @db.Date
  nationality         String?
  countryOfResidence  String?             @map("country_of_residence")

  // Address
  addressLine1        String?             @map("address_line1")
  addressLine2        String?             @map("address_line2")
  city                String?
  state               String?
  postalCode          String?             @map("postal_code")
  country             String?

  // Masked identifiers (raw values are NEVER stored here; optional encrypted
  // copies reuse the existing KYC AES-256-GCM layer when supplied).
  panLast4            String?             @map("pan_last4")
  panMasked           String?             @map("pan_masked")
  panEnc              Bytes?              @map("pan_enc")
  aadhaarLast4        String?             @map("aadhaar_last4")
  aadhaarMasked       String?             @map("aadhaar_masked")
  aadhaarRefEnc       Bytes?              @map("aadhaar_ref_enc")

  // Risk
  riskLevel           ComplianceRiskLevel @default(MEDIUM) @map("risk_level")
  riskScore           Int                 @default(0) @map("risk_score")
  riskReason          String?             @map("risk_reason")

  // Onboarding geo / device evidence (safe, coarse — never precise tracking)
  onboardingIp        String?             @map("onboarding_ip")
  onboardingCountry   String?             @map("onboarding_country")
  onboardingRegion    String?             @map("onboarding_region")
  onboardingCity      String?             @map("onboarding_city")
  onboardingLatitude  String?             @map("onboarding_latitude")
  onboardingLongitude String?             @map("onboarding_longitude")
  onboardingUserAgent String?             @map("onboarding_user_agent")
  geoCaptureStatus    GeoCaptureStatus    @default(NOT_CAPTURED) @map("geo_capture_status")

  // Liveness
  livenessStatus      LivenessStatus      @default(NOT_STARTED) @map("liveness_status")
  livenessProvider    String?             @map("liveness_provider")
  livenessReference   String?             @map("liveness_reference")
  livenessScore       Int?                @map("liveness_score")

  // AML/CFT screening posture
  sanctionsStatus     ScreeningStatus     @default(NOT_SCREENED) @map("sanctions_status")
  pepStatus           ScreeningStatus     @default(NOT_SCREENED) @map("pep_status")
  adverseMediaStatus  ScreeningStatus     @default(NOT_SCREENED) @map("adverse_media_status")

  // Provider linkage + review scheduling + retention
  kycProvider          String?            @map("kyc_provider")
  kycProviderReference String?            @map("kyc_provider_reference")
  consentVersion       String?            @map("consent_version")
  complianceNote       String?            @map("compliance_note")
  verifiedAt           DateTime?          @map("verified_at")
  reviewedByAdminId    String?            @map("reviewed_by_admin_id") @db.Uuid
  lastReviewedAt       DateTime?          @map("last_reviewed_at")
  nextReviewDueAt      DateTime?          @map("next_review_due_at")
  retentionUntil       DateTime?          @map("retention_until")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer Admin? @relation("ComplianceReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([riskLevel])
  @@index([nextReviewDueAt])
  @@map("compliance_profiles")
}

/// Audit-ready onboarding evidence. Stores LOCATORS + redacted metadata only —
/// never raw file content or raw identifiers.
model ComplianceEvidence {
  id                String                   @id @default(uuid()) @db.Uuid
  userId            String                   @map("user_id") @db.Uuid
  type              ComplianceEvidenceType
  status            ComplianceEvidenceStatus @default(PENDING)
  provider          String?
  referenceId       String?                  @map("reference_id")
  storageKey        String?                  @map("storage_key")
  documentId        String?                  @map("document_id") @db.Uuid
  metadata          Json?
  createdAt         DateTime                 @default(now()) @map("created_at")
  reviewedAt        DateTime?                @map("reviewed_at")
  reviewedByAdminId String?                  @map("reviewed_by_admin_id") @db.Uuid

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer Admin? @relation("ComplianceEvidenceReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([userId, createdAt])
  @@map("compliance_evidence")
}

/// Immutable record of an explicit user consent (PMLA/DPDP audit trail).
model ComplianceConsent {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  consentType ConsentType @map("consent_type")
  version     String
  ip          String?
  userAgent   String?     @map("user_agent")
  acceptedAt  DateTime    @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@map("compliance_consents")
}

/// Append-only history of risk scores with the reasons that produced them.
model RiskAssessment {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  score            Int
  level            ComplianceRiskLevel
  reasons          Json
  source           RiskAssessmentSource
  createdAt        DateTime             @default(now()) @map("created_at")
  createdByAdminId String?              @map("created_by_admin_id") @db.Uuid

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy Admin? @relation("RiskAssessmentAuthor", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("risk_assessments")
}

/// One sanctions / PEP / adverse-media screening check (Stage 5.1). Checks are
/// produced by a pluggable ComplianceScreeningProvider (mock in staging). A
/// "run" creates one row per category, grouped by `batchId`. Stores only a
/// redacted provider summary — never raw vendor payloads or credentials.
model ScreeningCheck {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  batchId          String               @map("batch_id") @db.Uuid
  category         ScreeningCategory
  status           ScreeningCheckStatus @default(PENDING)
  provider         String
  providerMode     String               @map("provider_mode") // 'mock' | 'live'
  providerReference String?             @map("provider_reference")
  score            Int                  @default(0) // 0..100 top-match confidence
  summary          String?
  decision         ScreeningDecision?
  decisionNote     String?              @map("decision_note")
  decidedByAdminId String?              @map("decided_by_admin_id") @db.Uuid
  decidedAt        DateTime?            @map("decided_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy Admin?           @relation("ScreeningDecider", fields: [decidedByAdminId], references: [id], onDelete: SetNull)
  matches   ScreeningMatch[]

  @@index([userId, createdAt])
  @@index([userId, category])
  @@index([batchId])
  @@map("screening_checks")
}

/// A single candidate match returned by a screening check. Redacted metadata
/// only (name fragment, list name, score) — no raw vendor document.
model ScreeningMatch {
  id         String            @id @default(uuid()) @db.Uuid
  checkId    String            @map("check_id") @db.Uuid
  category   ScreeningCategory
  name       String
  matchScore Int               @default(0) @map("match_score") // 0..100
  listName   String?           @map("list_name")
  sourceUrl  String?           @map("source_url")
  details    Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  check ScreeningCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([checkId])
  @@map("screening_matches")
}

// ============================================================================
// COMPLIANCE MONITORING — suspicious-transaction alerts + STR case workflow
// (Stage 5.2). Rule-based/mock only. These tables are ADDITIVE: the monitoring
// engine READS deposits / withdrawals / trades / inr_transactions but NEVER
// mutates ledger, trading, scanner, or withdrawal money-movement state, and it
// never deletes records.
// ============================================================================

/// Why a suspicious-activity alert fired.
enum ComplianceAlertType {
  HIGH_VALUE_WITHDRAWAL
  RAPID_DEPOSIT_WITHDRAWAL
  STRUCTURING_PATTERN
  ABNORMAL_TRADING_VOLUME
  REPEATED_FAILED_WITHDRAWALS
  HIGH_RISK_USER_ACTIVITY
  SCREENING_RISK_ACTIVITY
  WALLET_RISK_ACTIVITY
}

/// Lifecycle of a single alert.
enum ComplianceAlertStatus {
  OPEN
  IN_REVIEW
  LINKED_TO_CASE
  DISMISSED
  RESOLVED
}

/// Lifecycle of an investigation case.
enum ComplianceCaseStatus {
  OPEN
  IN_REVIEW
  ESCALATED
  STR_DRAFTED
  CLOSED
}

/// Triage priority of a case.
enum ComplianceCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// What kind of case this is.
enum ComplianceCaseType {
  SUSPICIOUS_TRANSACTION
  HIGH_RISK_USER
  WALLET_RISK
  SCREENING_MATCH
  MANUAL_REVIEW
}

/// One rule-based suspicious-activity alert. Idempotent on `dedupeKey`: the
/// monitoring engine derives a deterministic key per finding so re-running it
/// never produces duplicates. `details` holds redacted evidence (entity ids,
/// amounts) — never raw secrets/PII.
model ComplianceAlert {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  type              ComplianceAlertType
  status            ComplianceAlertStatus @default(OPEN)
  priority          ComplianceCasePriority @default(LOW)
  score             Int                   @default(0) // 0..100 heuristic severity
  title             String
  description       String?
  dedupeKey         String                @unique @map("dedupe_key")
  details           Json?
  caseId            String?               @map("case_id") @db.Uuid
  resolvedByAdminId String?               @map("resolved_by_admin_id") @db.Uuid
  resolvedAt        DateTime?             @map("resolved_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  case ComplianceCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@index([type])
  @@index([caseId])
  @@map("compliance_alerts")
}

/// An investigation case grouping one or more alerts for a user. Auto-opened by
/// the monitoring engine for HIGH/CRITICAL findings (idempotent on `dedupeKey` =
/// one auto case per user per UTC day) or created manually by an admin (no
/// dedupeKey). Admin actor ids are stored as plain uuids (no FK) to keep the
/// Admin model untouched, mirroring other nullable-actor columns.
model ComplianceCase {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  type             ComplianceCaseType     @default(SUSPICIOUS_TRANSACTION)
  status           ComplianceCaseStatus   @default(OPEN)
  priority         ComplianceCasePriority @default(MEDIUM)
  title            String
  summary          String?
  dedupeKey        String?                @unique @map("dedupe_key")
  assignedToAdminId String?               @map("assigned_to_admin_id") @db.Uuid
  openedByAdminId  String?                @map("opened_by_admin_id") @db.Uuid // null = system/auto
  closedByAdminId  String?                @map("closed_by_admin_id") @db.Uuid
  closedAt         DateTime?              @map("closed_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts ComplianceAlert[]
  notes  ComplianceCaseNote[]
  events ComplianceCaseEvent[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([priority])
  @@index([assignedToAdminId])
  @@map("compliance_cases")
}

/// Free-text investigation note on a case. Append-only in practice (the service
/// never deletes). `adminId` is the author (plain uuid, no FK).
model ComplianceCaseNote {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @map("case_id") @db.Uuid
  adminId   String?  @map("admin_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  case ComplianceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("compliance_case_notes")
}

/// Append-only audit timeline for a case (CASE_CREATED, STATUS_CHANGED,
/// ASSIGNED, NOTE_ADDED, ALERT_LINKED, STR_EXPORTED, RISK_APPLIED, ...).
/// `action` is a stable string code; `metadata` holds redacted detail.
model ComplianceCaseEvent {
  id            String   @id @default(uuid()) @db.Uuid
  caseId        String   @map("case_id") @db.Uuid
  action        String
  actorAdminId  String?  @map("actor_admin_id") @db.Uuid // null = system/auto
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  case ComplianceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("compliance_case_events")
}

// ============================================================================
// WALLET RISK + TRAVEL RULE FOUNDATION (Stage 5.3)
//
// Rule-based/mock only. These tables are ADDITIVE and DETECTION-ONLY: a
// pluggable WalletRiskProvider (mock in staging) screens crypto addresses, and
// TravelRuleTransfer records the data-collection lifecycle for transfers over a
// threshold. NOTHING here performs real chain analytics, calls a paid vendor,
// submits a real Travel Rule message, mutates the ledger/scanner/matching
// engine, or changes withdrawal signing. Records are never auto-deleted.
// ============================================================================

/// Coarse wallet-risk grade returned by the (mock) provider.
enum WalletRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Disposition of a wallet-risk check.
enum WalletRiskStatus {
  CLEAR
  REVIEW_REQUIRED
  BLOCKED
  FAILED
}

/// Travel Rule data-collection lifecycle (mock — never a real FIU/VASP filing).
enum TravelRuleStatus {
  NOT_REQUIRED
  REQUIRED
  PENDING_INFO
  READY
  SENT_MOCK
  FAILED
  EXEMPTED
}

/// Direction of a transfer for Travel Rule / wallet-risk purposes.
enum TravelRuleDirection {
  INBOUND
  OUTBOUND
}

/// Latest risk posture for a (chain,address) pair — one row per address, updated
/// by each check. An admin may pin an `overriddenLevel`.
model WalletRiskProfile {
  id                  String           @id @default(uuid()) @db.Uuid
  chain               String           @db.Citext
  address             String
  level               WalletRiskLevel  @default(LOW)
  status              WalletRiskStatus @default(CLEAR)
  score               Int              @default(0)
  checkCount          Int              @default(0) @map("check_count")
  categories          Json?
  overriddenLevel     WalletRiskLevel? @map("overridden_level")
  overriddenByAdminId String?          @map("overridden_by_admin_id") @db.Uuid
  notes               String?
  lastCheckId         String?          @map("last_check_id") @db.Uuid
  firstSeenAt         DateTime         @default(now()) @map("first_seen_at")
  lastScreenedAt      DateTime?        @map("last_screened_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  checks WalletRiskCheck[]
  events WalletRiskEvent[]

  @@unique([chain, address])
  @@index([level])
  @@index([status])
  @@map("wallet_risk_profiles")
}

/// One wallet-risk screening result. Idempotent on `dedupeKey`. Stores only a
/// redacted provider summary + category labels — never raw vendor payloads.
model WalletRiskCheck {
  id                String              @id @default(uuid()) @db.Uuid
  profileId         String?             @map("profile_id") @db.Uuid
  userId            String?             @map("user_id") @db.Uuid
  chain             String              @db.Citext
  address           String
  direction         TravelRuleDirection?
  level             WalletRiskLevel     @default(LOW)
  status            WalletRiskStatus    @default(CLEAR)
  provider          String
  providerMode      String              @map("provider_mode") // 'mock' | 'live'
  score             Int                 @default(0)
  summary           String?
  categories        Json?
  dedupeKey         String              @unique @map("dedupe_key")
  withdrawalId      String?             @map("withdrawal_id") @db.Uuid
  depositId         String?             @map("deposit_id") @db.Uuid
  alertId           String?             @map("alert_id") @db.Uuid
  caseId            String?             @map("case_id") @db.Uuid
  reviewDecision    WalletRiskStatus?   @map("review_decision")
  reviewNote        String?             @map("review_note")
  reviewedByAdminId String?             @map("reviewed_by_admin_id") @db.Uuid
  reviewedAt        DateTime?           @map("reviewed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  profile WalletRiskProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  user    User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([chain, address])
  @@index([status])
  @@index([level])
  @@map("wallet_risk_checks")
}

/// Append-only history of wallet-risk events for a profile (screened, reviewed,
/// overridden, alert/case linked). Admin actor ids are plain uuids (no FK).
model WalletRiskEvent {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  action       String
  actorAdminId String?  @map("actor_admin_id") @db.Uuid
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  profile WalletRiskProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("wallet_risk_events")
}

/// A counterparty VASP for Travel Rule purposes (mock directory).
model TravelRuleCounterparty {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  vaspCode  String?  @map("vasp_code")
  chain     String?  @db.Citext
  address   String?
  type      String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transfers TravelRuleTransfer[]

  @@index([name])
  @@map("travel_rule_counterparties")
}

/// Travel Rule data-collection record for a transfer over the threshold. This is
/// a MOCK lifecycle: SENT_MOCK never transmits a real Travel Rule message.
model TravelRuleTransfer {
  id                  String              @id @default(uuid()) @db.Uuid
  direction           TravelRuleDirection
  status              TravelRuleStatus    @default(NOT_REQUIRED)
  userId              String?             @map("user_id") @db.Uuid
  chain               String              @db.Citext
  asset               String              @db.Citext
  amount              Decimal             @db.Decimal(38, 18)
  thresholdAmount     Decimal?            @map("threshold_amount") @db.Decimal(38, 18)
  counterpartyAddress String?             @map("counterparty_address")
  counterpartyId      String?             @map("counterparty_id") @db.Uuid
  originatorName      String?             @map("originator_name")
  beneficiaryName     String?             @map("beneficiary_name")
  withdrawalId        String?             @map("withdrawal_id") @db.Uuid
  depositId           String?             @map("deposit_id") @db.Uuid
  dedupeKey           String              @unique @map("dedupe_key")
  infoCollectedAt     DateTime?           @map("info_collected_at")
  sentMockAt          DateTime?           @map("sent_mock_at")
  exemptedReason      String?             @map("exempted_reason")
  reviewedByAdminId   String?             @map("reviewed_by_admin_id") @db.Uuid
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  user         User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  counterparty TravelRuleCounterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([direction])
  @@index([userId, createdAt])
  @@map("travel_rule_transfers")
}

// ============================================================================
// RECORD RETENTION + COMPLIANCE EVIDENCE PACK (Stage 5.4)
//
// Audit-ready, JSON-first evidence packs that AGGREGATE existing compliance data
// (Stage 5.0 KYC/risk, 5.1 screening, 5.2 alerts/cases, 5.3 wallet-risk/Travel
// Rule) plus a record-retention review foundation. Everything is ADDITIVE and
// READ-ONLY over the source tables: nothing here files an FIU report, deletes a
// record, or mutates ledger / scanner / matching / withdrawal-signing state.
// Packs store masked/minimized snapshots only — never secrets or raw PAN/Aadhaar.
// ============================================================================

/// What a compliance evidence pack covers.
enum EvidencePackType {
  USER_KYC
  STR_CASE
  WALLET_RISK
  TRAVEL_RULE
  FULL_USER_COMPLIANCE
}

/// Build lifecycle of an evidence pack.
enum EvidencePackStatus {
  QUEUED
  BUILDING
  READY
  FAILED
  EXPIRED
}

/// Output format. PDF is a labelled placeholder only (no real PDF rendering).
enum EvidencePackFormat {
  JSON
  PDF_PLACEHOLDER
}

/// Whether a retention policy is currently in force.
enum RetentionPolicyStatus {
  ACTIVE
  DISABLED
}

/// Lifecycle of a (review-only, non-destructive) retention review.
enum RetentionReviewStatus {
  PENDING
  REVIEWED
  ESCALATED
}

/// What kind of export an export-event records.
enum ComplianceExportType {
  EVIDENCE_PACK
  USER_COMPLIANCE_EXPORT
  CASE_EXPORT
  RETENTION_REVIEW_EXPORT
}

/// One audit-ready evidence pack. `payload` holds the masked, secrets-free pack
/// JSON; `checksum` is a SHA-256 over the canonical payload for tamper-evidence.
model ComplianceEvidencePack {
  id                 String             @id @default(uuid()) @db.Uuid
  packType           EvidencePackType
  status             EvidencePackStatus @default(QUEUED)
  format             EvidencePackFormat @default(JSON)
  label              String             @default("INTERNAL_COMPLIANCE_EVIDENCE_PACK_STAGING_ONLY")
  title              String
  summary            String?
  scopeUserId        String?            @map("scope_user_id") @db.Uuid
  scopeCaseId        String?            @map("scope_case_id") @db.Uuid
  scopeRef           String?            @map("scope_ref") // wallet-risk profile id / travel-rule id / etc.
  itemCount          Int                @default(0) @map("item_count")
  checksum           String?
  payload            Json?
  error              String?
  generatedByAdminId String?            @map("generated_by_admin_id") @db.Uuid
  expiresAt          DateTime?          @map("expires_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user       User?                        @relation(fields: [scopeUserId], references: [id], onDelete: SetNull)
  items      ComplianceEvidencePackItem[]
  fiuReports FiuDraftReport[]

  @@index([packType])
  @@index([status])
  @@index([scopeUserId, createdAt])
  @@map("compliance_evidence_packs")
}

/// A single masked snapshot inside a pack (one per source record/group).
model ComplianceEvidencePackItem {
  id        String   @id @default(uuid()) @db.Uuid
  packId    String   @map("pack_id") @db.Uuid
  itemType  String   @map("item_type") // KYC_PROFILE | SCREENING_CHECK | RISK_ASSESSMENT | ALERT | CASE | WALLET_RISK_CHECK | TRAVEL_RULE | AUDIT_LOG | ...
  refId     String?  @map("ref_id")
  title     String
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  pack ComplianceEvidencePack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
  @@map("compliance_evidence_pack_items")
}

/// Record-retention policy per record type (review-only; NEVER auto-deletes).
model RecordRetentionPolicy {
  id                 String                @id @default(uuid()) @db.Uuid
  recordType         String                @unique @map("record_type") // KYC | COMPLIANCE_EVIDENCE | STR_CASE | WALLET_RISK | TRAVEL_RULE | AUDIT_LOG | TAX_LEGAL
  retentionYears     Int                   @map("retention_years")
  status             RetentionPolicyStatus @default(ACTIVE)
  description        String?
  createdByAdminId   String?               @map("created_by_admin_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  reviews RecordRetentionReview[]

  @@map("record_retention_policies")
}

/// A review pass over records under a policy. Counts only — no deletion. Status
/// transitions PENDING -> REVIEWED / ESCALATED.
model RecordRetentionReview {
  id                   String                @id @default(uuid()) @db.Uuid
  policyId             String?               @map("policy_id") @db.Uuid
  recordType           String                @map("record_type")
  status               RetentionReviewStatus @default(PENDING)
  periodStart          DateTime?             @map("period_start")
  periodEnd            DateTime?             @map("period_end")
  eligibleCount        Int                   @default(0) @map("eligible_count")
  retainedCount        Int                   @default(0) @map("retained_count")
  nearingBoundaryCount Int                   @default(0) @map("nearing_boundary_count")
  notes                String?
  reviewedByAdminId    String?               @map("reviewed_by_admin_id") @db.Uuid
  reviewedAt           DateTime?             @map("reviewed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  policy RecordRetentionPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([recordType])
  @@index([status])
  @@map("record_retention_reviews")
}

/// Append-only log of every compliance export (pack download, case export, etc.)
/// for accountability. Carries references + checksum — never the payload.
model ComplianceExportEvent {
  id          String               @id @default(uuid()) @db.Uuid
  exportType  ComplianceExportType
  packId      String?              @map("pack_id") @db.Uuid
  scopeUserId String?              @map("scope_user_id") @db.Uuid
  scopeRef    String?              @map("scope_ref")
  format      String?
  checksum    String?
  label       String               @default("INTERNAL_COMPLIANCE_EVIDENCE_PACK_STAGING_ONLY")
  adminId     String?              @map("admin_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([exportType, createdAt])
  @@index([packId])
  @@index([scopeUserId, createdAt])
  @@map("compliance_export_events")
}

// ============================================================================
// TAX / TDS + LEGAL ACCEPTANCE (Stage 5.5)
//
// India-focused tax/TDS CALCULATION-ONLY foundation + versioned legal documents
// and user acceptance. Everything is ADDITIVE and staging-safe: TDS is computed
// and recorded but NEVER deducted from the ledger, nothing is filed with Income
// Tax / GST / any government system, and no money-movement logic changes.
// Outputs are labelled TAX_TDS_STAGING_CALCULATION_ONLY.
// ============================================================================

enum TaxRuleStatus {
  ACTIVE
  DISABLED
}

enum TaxEventType {
  TRADE_SELL
  WITHDRAWAL
  CONVERSION
  FEE
  OTHER
}

enum TdsRecordStatus {
  CALCULATED
  WAIVED
  REVERSED
  FAILED
}

enum TaxStatementStatus {
  DRAFT
  GENERATED
  EXPIRED
}

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  RISK_DISCLOSURE
  AML_POLICY_NOTICE
  FEE_POLICY
  TAX_DISCLOSURE
}

enum LegalAcceptanceStatus {
  ACCEPTED
  REVOKED
  SUPERSEDED
}

/// Configurable TDS/tax rule per taxable event type (one active config per type).
model TaxRule {
  id               String        @id @default(uuid()) @db.Uuid
  eventType        TaxEventType  @unique @map("event_type")
  name             String
  rateBps          Int           @map("rate_bps") // TDS rate in basis points (e.g. 100 = 1%)
  thresholdAmount  Decimal?      @map("threshold_amount") @db.Decimal(38, 18)
  status           TaxRuleStatus @default(ACTIVE)
  description      String?
  createdByAdminId String?       @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tdsRecords TdsRecord[]

  @@map("tax_rules")
}

/// Per-user tax posture (PAN availability drives higher-TDS flagging).
model UserTaxProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  panAvailable        Boolean  @default(false) @map("pan_available")
  panStatus           String?  @map("pan_status") // PROVIDED | MASKED_ONLY | MISSING
  residentStatus      String?  @map("resident_status") // RESIDENT | NON_RESIDENT
  taxJurisdiction     String   @default("IN") @map("tax_jurisdiction")
  higherTdsApplicable Boolean  @default(false) @map("higher_tds_applicable")
  notes               String?
  updatedByAdminId    String?  @map("updated_by_admin_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_tax_profiles")
}

/// A CALCULATION-ONLY TDS record for a taxable event. Never deducts from ledger.
model TdsRecord {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  eventType        TaxEventType    @map("event_type")
  ruleId           String?         @map("rule_id") @db.Uuid
  sourceType       String?         @map("source_type") // TRADE | WITHDRAWAL | CONVERSION | ...
  sourceRef        String?         @map("source_ref")
  grossAmount      Decimal         @map("gross_amount") @db.Decimal(38, 18)
  asset            String?
  rateBps          Int             @map("rate_bps")
  tdsAmount        Decimal         @map("tds_amount") @db.Decimal(38, 18)
  status           TdsRecordStatus @default(CALCULATED)
  label            String          @default("TAX_TDS_STAGING_CALCULATION_ONLY")
  financialYear    String?         @map("financial_year")
  notes            String?
  createdByAdminId String?         @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule TaxRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType])
  @@index([status])
  @@map("tds_records")
}

/// A JSON-first internal tax statement per user + financial year.
model TaxStatement {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  financialYear    String             @map("financial_year")
  status           TaxStatementStatus @default(DRAFT)
  label            String             @default("TAX_TDS_STAGING_CALCULATION_ONLY")
  totalGross       Decimal            @default(0) @map("total_gross") @db.Decimal(38, 18)
  totalTds         Decimal            @default(0) @map("total_tds") @db.Decimal(38, 18)
  recordCount      Int                @default(0) @map("record_count")
  checksum         String?
  payload          Json?
  generatedByAdminId String?          @map("generated_by_admin_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, financialYear])
  @@index([status])
  @@map("tax_statements")
}

/// A versioned legal document (content + checksum). `isCurrent` marks the live
/// version of each type.
model LegalDocumentVersion {
  id               String            @id @default(uuid()) @db.Uuid
  type             LegalDocumentType
  version          String
  title            String
  content          String
  checksum         String
  isCurrent        Boolean           @default(false) @map("is_current")
  effectiveAt      DateTime          @default(now()) @map("effective_at")
  createdByAdminId String?           @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")

  acceptances UserLegalAcceptance[]

  @@unique([type, version])
  @@index([type, isCurrent])
  @@map("legal_document_versions")
}

/// An immutable record that a user accepted a specific legal document version.
model UserLegalAcceptance {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  documentType      LegalDocumentType     @map("document_type")
  documentVersionId String?               @map("document_version_id") @db.Uuid
  version           String
  checksum          String?
  status            LegalAcceptanceStatus @default(ACCEPTED)
  ip                String?
  userAgent         String?               @map("user_agent")
  acceptedAt        DateTime              @default(now()) @map("accepted_at")
  revokedAt         DateTime?             @map("revoked_at")

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentVersion LegalDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)

  @@index([userId, documentType])
  @@map("user_legal_acceptances")
}

// ============================================================================
// FIU DRAFT REPORTING (Stage 5.6)
//
// DRAFT-ONLY internal STR/CTR/NTR report generation from existing compliance
// data (5.2 cases/alerts, 5.3 wallet-risk, 5.4 evidence packs). ADDITIVE and
// staging-safe: every draft is labelled FIU_DRAFT_REPORT_STAGING_ONLY with a
// NOT_SUBMITTED_TO_FIU state. NOTHING here calls an FIU API/portal, transmits a
// report, mutates money-movement state, or deletes records.
// ============================================================================

enum FiuReportType {
  STR
  CTR
  NTR
  CBWTR
  INTERNAL_SUSPICIOUS_ACTIVITY_SUMMARY
}

enum FiuDraftStatus {
  DRAFT
  VALIDATING
  READY_FOR_INTERNAL_REVIEW
  EXPORTED_DRAFT
  FAILED
  ARCHIVED
}

enum FiuReportFormat {
  JSON_DRAFT
  XML_PLACEHOLDER
  CSV_PLACEHOLDER
}

enum FiuValidationSeverity {
  INFO
  WARNING
  ERROR
}

enum FiuReportScopeType {
  USER
  CASE
  DATE_RANGE
  TRANSACTION_SET
}

/// One FIU draft report. `payload` holds the masked draft JSON; `checksum` is a
/// SHA-256 over it. Never submitted — see `submissionState`.
model FiuDraftReport {
  id                 String             @id @default(uuid()) @db.Uuid
  reportType         FiuReportType      @map("report_type")
  status             FiuDraftStatus     @default(DRAFT)
  scopeType          FiuReportScopeType @map("scope_type")
  format             FiuReportFormat    @default(JSON_DRAFT)
  label              String             @default("FIU_DRAFT_REPORT_STAGING_ONLY")
  submissionState    String             @default("NOT_SUBMITTED_TO_FIU") @map("submission_state")
  title              String
  narrative          String?
  scopeUserId        String?            @map("scope_user_id") @db.Uuid
  scopeCaseId        String?            @map("scope_case_id") @db.Uuid
  evidencePackId     String?            @map("evidence_pack_id") @db.Uuid
  periodStart        DateTime?          @map("period_start")
  periodEnd          DateTime?          @map("period_end")
  sourceRefs         Json?              @map("source_refs")
  checksum           String?
  payload            Json?
  errorCount         Int                @default(0) @map("error_count")
  warningCount       Int                @default(0) @map("warning_count")
  generatedByAdminId String?            @map("generated_by_admin_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user         User?                   @relation(fields: [scopeUserId], references: [id], onDelete: SetNull)
  evidencePack ComplianceEvidencePack? @relation(fields: [evidencePackId], references: [id], onDelete: SetNull)
  items        FiuDraftReportItem[]
  issues       FiuReportValidationIssue[]

  @@index([reportType])
  @@index([status])
  @@index([scopeUserId, createdAt])
  @@map("fiu_draft_reports")
}

/// A masked snapshot inside an FIU draft report (subject, case, alert, etc.).
model FiuDraftReportItem {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  itemType  String   @map("item_type")
  refId     String?  @map("ref_id")
  title     String
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  report FiuDraftReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("fiu_draft_report_items")
}

/// A validation finding for an FIU draft report (INFO / WARNING / ERROR).
model FiuReportValidationIssue {
  id        String                @id @default(uuid()) @db.Uuid
  reportId  String                @map("report_id") @db.Uuid
  severity  FiuValidationSeverity
  code      String
  field     String?
  message   String
  createdAt DateTime              @default(now()) @map("created_at")

  report FiuDraftReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("fiu_report_validation_issues")
}

/// Append-only log of FIU draft exports (download). Never an FIU submission.
model FiuReportExportEvent {
  id              String        @id @default(uuid()) @db.Uuid
  reportId        String        @map("report_id") @db.Uuid
  reportType      FiuReportType @map("report_type")
  format          String?
  checksum        String?
  label           String        @default("FIU_DRAFT_REPORT_STAGING_ONLY")
  submissionState String        @default("NOT_SUBMITTED_TO_FIU") @map("submission_state")
  adminId         String?       @map("admin_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([reportId])
  @@index([reportType, createdAt])
  @@map("fiu_report_export_events")
}
