# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Max JSON body size accepted by the API
BODY_LIMIT=100kb
# Public base path / api version prefix
API_PREFIX=/api/v1

# ============================================================
# Logging
# ============================================================
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Pretty-print logs (true in dev, false in prod for JSON shipping)
LOG_PRETTY=true

# ============================================================
# PostgreSQL (Prisma)
# ============================================================
# When running the API inside docker-compose, host is "postgres".
# When running the API on the host against compose, host is "localhost".
DATABASE_URL=postgresql://cex:cex_password@localhost:5432/cex?schema=public

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# JWT Authentication
# ============================================================
# Use long, random, high-entropy secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_value
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_value
# Access token lifetime (short). Refresh token lifetime (long).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ============================================================
# Rate limiting (per window, per IP)
# ============================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# ============================================================
# Login lockout (account brute-force protection)
# ============================================================
# Max failed login attempts (per email+IP) within the rolling window before
# the account is temporarily locked out.
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
# Rolling window in ms over which failed attempts are counted (default 15 min).
LOGIN_LOCKOUT_WINDOW_MS=900000

# ============================================================
# Compliance: liveness + AML screening (Stage 5.0 / 5.1)
# ============================================================
# All providers are offline mocks in dev/staging; real vendors are pluggable
# later via these env vars. No real paid provider is ever called from a mock.
KYC_LIVENESS_PROVIDER=mock
SCREENING_PROVIDER=mock
COMPLIANCE_REQUIRE_LIVENESS=false
COMPLIANCE_REQUIRE_SANCTIONS_BEFORE_APPROVAL=false
COMPLIANCE_DEFAULT_RISK_LEVEL=MEDIUM
COMPLIANCE_RECORD_RETENTION_YEARS=5

# ============================================================
# INR deposits / Razorpay
# ============================================================
# Provider: "mock" (offline, deterministic — dev/test default) or "live".
# "live" REQUIRES real RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET or the app refuses
# to boot — we never call the real Razorpay API with placeholder credentials.
RAZORPAY_PROVIDER=mock
# Razorpay API credentials (leave blank in mock mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=dev-only-razorpay-key-secret-change-me
# Webhook signing secret (Razorpay Dashboard → Webhooks). Verifies inbound HMAC.
RAZORPAY_WEBHOOK_SECRET=dev-only-razorpay-webhook-secret-change-me
# Real Razorpay REST base (only used by the live provider).
RAZORPAY_API_BASE=https://api.razorpay.com/v1
# INR deposit bounds (rupees, scale 2).
INR_DEPOSIT_MIN=100.00
INR_DEPOSIT_MAX=1000000.00
# Manual INR deposit transfer destination (Stage 10A). Served read-only via
# GET /inr/deposits/instructions to both web and mobile — not secrets.
INR_DEPOSIT_BANK_NAME=HDFC Bank
INR_DEPOSIT_BENEFICIARY_NAME=Exora India Private Limited
INR_DEPOSIT_ACCOUNT_NUMBER=50200084192837
INR_DEPOSIT_IFSC=HDFC0000240
INR_DEPOSIT_ACCOUNT_TYPE=Current Account
INR_DEPOSIT_UPI_ID=exora.india@icici
# Operator attestation (Stage 10B) that the values above are the real, current
# collection destination. Defaults to false — set true ONLY after a human has
# confirmed the banking details; while false, GET /inr/deposits/instructions
# withholds the account/UPI values and returns a safe unavailable state.
INR_DEPOSIT_INSTRUCTIONS_VERIFIED=false

# KYC document object storage (Stage 10B). 'mock' = non-routable stub, no
# document bytes are ever actually persisted. 's3' requires the vars below and
# fails loudly (not a silent fallback) if they are absent.
KYC_STORAGE_PROVIDER=mock
KYC_S3_BUCKET=
KYC_S3_REGION=
# Customer-managed KMS key id/ARN for SSE-KMS. Optional — SSE-S3 (AES256) is
# used when absent, but a CMK is required before this is production-ready.
KYC_S3_KMS_KEY_ID=

# ============================================================
# Crypto withdrawals
# ============================================================
# Keep mock in staging unless the isolated signer is implemented and reviewed.
WITHDRAWAL_SIGNER=mock
WITHDRAWAL_FEE_USDT=1
WITHDRAWAL_MIN_USDT=10
WITHDRAWAL_DUAL_APPROVAL_THRESHOLD=1000
WITHDRAWAL_ADDRESS_COOLDOWN_MS=0

# ============================================================
# Email / transactional mail (Stage 12: Resend)
# ============================================================
# 'log' (default) = offline stub, no real email. 'ses' = AWS SES. 'resend' =
# Resend API — requires RESEND_API_KEY + RESEND_FROM_EMAIL or the app refuses
# to boot (same fail-fast pattern as MAIL_PROVIDER=ses + AWS_REGION).
MAIL_PROVIDER=log
MAIL_FROM=Exora <no-reply@exora.local>
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Exora
# Svix signing secret for the inbound Resend delivery-events webhook
# (POST /api/v1/webhooks/resend). Absent = the webhook rejects every event as
# unverified rather than silently accepting unsigned payloads.
# RESEND_WEBHOOK_SECRET=

# ============================================================
# Federated identity: Google/Apple via Firebase Authentication (Stage 12)
# ============================================================
# Firebase is a verification layer ONLY — EXORA remains authoritative for
# users/sessions/tokens. Off by default; safe to enable before the Firebase
# Admin credentials below exist (POST /auth/federated/firebase then returns a
# clear "temporarily unavailable" response instead of crashing boot).
FEDERATED_AUTH_ENABLED=false
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ============================================================
# Live market data: BTC/USDT, ETH/USDT, BNB/USDT, USDT/INR (reference)
# ============================================================
# MARKET DATA ONLY — grants no crypto execution capability. See
# backend/src/modules/market-data/. Keep PLATFORM_MODE / CRYPTO_*_GLOBAL_ENABLED
# above unchanged; this section does not affect them.
#
# Binance public market-data-only hosts. No API key — never add one here.
BINANCE_MARKET_DATA_REST_BASE=https://data-api.binance.vision
BINANCE_MARKET_DATA_WS_BASE=wss://data-stream.binance.vision
BINANCE_TICKER_STALE_MS=15000
#
# CoinGecko Demo API — USDT/INR reference price only. Backend-only; never
# exposed as NEXT_PUBLIC_*/EXPO_PUBLIC_*. Absent key = USDTINR market data
# stays "unavailable" (fails closed, never fabricates a price). Production:
# inject via AWS Secrets Manager as cex/<env>/COINGECKO_DEMO_API_KEY, not a
# plaintext ECS environment[] entry.
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# COINGECKO_DEMO_API_KEY=
COINGECKO_POLL_MS=300000
COINGECKO_STALE_MS=900000
